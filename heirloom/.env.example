# Supabase (hosted). All values come from the Supabase dashboard; see README.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Use the Session pooler string (port 5432), with your DB password filled in.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

OPENAI_API_KEY=
# M2
ANTHROPIC_API_KEY=

DEMO_MODE=true
WEB_ORIGIN=http://localhost:3100

# Web app
NEXT_PUBLIC_API_URL=http://localhost:8000
